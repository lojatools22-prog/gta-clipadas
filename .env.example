# ===== Obrigatórias pra lançar =====
PUBLIC_URL=https://gtaclipadas.com.br       # endereço do site (usado no retorno do pagamento)
ADMIN_EMAILS=seuemail@exemplo.com           # quem pode abrir /admin (separe por vírgula)
DATA_DIR=/data                              # Volume do Railway

# SMS (Twilio): código no cadastro e ao entrar em aparelho novo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                                # número ou remetente da Twilio
LOGIN_SMS=1                                 # 1 = pede SMS em aparelho novo

# Pagamento (Mercado Pago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=                          # "assinatura secreta" do webhook no painel do MP

# Legenda automática (Groq é o mais barato)
GROQ_API_KEY=

# Twitch (aba Virais) — conta precisa de 2FA
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# E-mail (esqueci a senha pra quem não confirmou o celular)
RESEND_API_KEY=
MAIL_FROM=GTA Clipadas <nao-responda@gtaclipadas.com.br>

# ===== Opcionais =====
FREE_CLIPS=3
RETENTION_DAYS=30
MAX_CLIP_SECONDS=180
WORKERS=2
# Códigos de uso único por plano (vender por fora / dar de brinde)
CODES_INICIANTE=
CODES_CLIPADOR=
CODES_PRO=
CODES_PASSE=
DEV_SHOW_CODES=0                            # NUNCA 1 em produção

# ===== Pagamento pelo Asaas (usado no lugar do Mercado Pago quando ASAAS_API_KEY existe) =====
PAYMENT_PROVIDER=asaas
ASAAS_API_KEY=                              # Integrações > Chave de API (produção)
ASAAS_ENV=production                        # ou sandbox pra testar
ASAAS_WEBHOOK_TOKEN=                        # token de 32+ caracteres que você define no webhook
